# Copy to .env and fill in. Do not commit .env with real secrets.

# Optional: AI-generated itineraries via /api/plan
GEMINI_API_KEY=

# Optional: public URL (e.g. https://yourdomain.com)
APP_URL=http://localhost:3000

# MongoDB — local dev default; use Atlas or other in production
MONGODB_URI=mongodb://localhost:27017/tripaddicts

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# OpenWeather — when set, trip weather uses live OpenWeatherMap current weather (lat/lon from your map).
# If the call fails or this is empty, the server falls back to Open-Meteo (no key), then a mock.
# Set WEATHER_BLEND_ELEVATION=false to use only the raw OpenWeather temperature (no hill adjustment).
OPENWEATHER_API_KEY=
VITE_OPENWEATHER_API_KEY=
WEATHER_BLEND_ELEVATION=

# Unsplash — Discover photos: https://unsplash.com/oauth/applications
# Use the application's "Access Key" (public). Do NOT use the Secret key.
# One line, no quotes: UNSPLASH_ACCESS_KEY=xxxxxxxx
UNSPLASH_ACCESS_KEY=
# Optional alias if you already use Vite-style naming:
VITE_UNSPLASH_ACCESS_KEY=
